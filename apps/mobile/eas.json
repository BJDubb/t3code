{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "personal": {
      "corepack": true,
      "distribution": "store",
      "environment": "production",
      "channel": "personal",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "T3CODE_PERSONAL_IOS": "1",
        "MOBILE_VERSION_POLICY": "appVersion",
        "T3CODE_PERSONAL_EXPO_OWNER": "neps-beck",
        "T3CODE_PERSONAL_EAS_PROJECT_ID": "70cfda02-4792-410c-8df9-6a5ffdbd8fc5",
        "T3CODE_PERSONAL_APPLE_TEAM_ID": "QYLD5HP4HU",
        "T3CODE_MOBILE_UPDATES_ENABLED": "0",
        "T3CODE_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsudDMuY29kZXMk",
        "T3CODE_CLERK_JWT_TEMPLATE": "t3-relay",
        "T3CODE_RELAY_URL": "https://relay.t3.codes",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    },
    "development": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "development",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal"
    },
    "preview:dev": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "MOBILE_VERSION_POLICY": "fingerprint",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "v2-preview": {
      "extends": "production",
      "distribution": "store",
      "channel": "v2-preview",
      "env": {
        "T3CODE_MOBILE_UPDATES_ENABLED": "0"
      }
    },
    "production": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "production",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "personal": {},
    "v2-preview": {
      "extends": "production",
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6787819824"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
